// Folder-specific settings
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
{
  "languages": {
    "Nix": {
      "language_servers": ["nil", "nixd"],
    },
  },
  "lsp": {
    "nil": {
      "initialization_options": {
        "formatting": {
          "command": "nixfmt",
        },
      },
      "settings": {
        "diagnostics": {
          "ignored": ["unused_binding"],
        },
      },
    },
    "nixd": {
      "settings": {
        "nixos": {
          "expr": "(builtins.getFlake (toString ./.)).nixosConfigurations.vrrr.options",
        },
        "darwin": {
          "expr": "(builtins.getFlake (toString ./.)).nixosConfigurations.codifier.options",
        },
        "home_manager": {
          "expr": "(builtins.getFlake (toString ./.)).homeConfigurations.\"noah@codifier\".options",
        },
      },
    },
  },
}
